                        <span class="tab-title" data-key="insights_card_1_title">Core Flow</span>
                    </button>
                    <button class="tab-btn" role="tab" aria-selected="false" aria-controls="module-02" data-target="module-02">
                        <span class="tab-title" data-key="insights_card_2_title">Loyalty Program</span>
                    </button>
                    <button class="tab-btn" role="tab" aria-selected="false" aria-controls="module-03" data-target="module-03">
                        <span class="tab-title" data-key="insights_card_3_title">Credit Management</span>
                    </button>
                </div>
                <div class="tabs-content-container reveal-on-scroll">
                    <!-- Módulo 01 -->
                    <div class="accordion-item active" id="module-01" role="tabpanel">
                        <div class="accordion-header">
                            <div class="header-left">
                                <h5 class="cell-headline" data-key="insights_card_1_title">Core Flow</h5>
                            </div>
                            <button class="accordion-cta-btn" tabindex="-1">
                                <span class="cta-text" data-key="cta_see_less">Ver menos</span>
                                <svg class="cta-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </button>
                        </div>                        
                        <div class="accordion-content">
                            <div class="content-inner layout-split">
                                <!-- LADO IZQUIERDO: Textos (1.5fr) -->
                                <div class="text-side">
                                    <p class="problem-text" data-key="insights_user_1">
                                        Design of the main navigation and checkout architecture. Reduced transactional friction through an intuitive flow that guides users clearly from discovery to conversion.
                                    </p>
                                    <div class="mockup-explanation-block">
                                        <p class="mockup-caption" data-key="insights_detail_1">➔ Showing: Main catalog scroll and persistent checkout trigger.</p>
                                        <span class="scroll-hint" data-key="scroll_hint">🖱️ Scroll inside the device to explore the full layout</span>
