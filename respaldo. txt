.step-text p { font-size: 1.125rem; line-height: 1.6; color: var(--text-secondary, #666); margin: 0; }

/* ==========================================
   VISOR PDF: ESTRATEGIA DESKTOP (HUG & FILL)
=========================================== */
.wrapper-pdf {
    position: relative;
    width: 100%;
    height: 100%;
    align-self: stretch; 
}

.mock-pdf-viewer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0; 
    border-radius: 12px;
    overflow: hidden; 
    background: #323639;
    border: 1px solid var(--border, #e4e4e7);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
}

/* Barra Superior */
.viewer-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: #1a1a1c;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    flex-shrink: 0; 
