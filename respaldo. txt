}

.challenge-subtitle {
    font-size: 1.2rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 1.5rem 0;
}

/* Lista de Flujos al 100% */
.challenge-flows-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%; /* Forzar el ancho completo de la lista */
}

.challenge-flows-list li {
    width: 100%;
    display: block;
    box-sizing: border-box;
}

/* Tarjeta interactiva (Todo el contenedor es el CTA) */
.flow-card-link {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 14px 20px;
    border-radius: 12px;
    text-decoration: none; /* Eliminar sublineado nativo de enlaces */
    width: 100%;
    box-sizing: border-box;
    transition: background 0.2s ease, border-color 0.2s ease;
}

/* Hover de la ficha completa */
.flow-card-link:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
}

.flow-icon {
    font-size: 1.35rem;
    flex-shrink: 0;
}

.flow-content {
    font-size: 1rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
