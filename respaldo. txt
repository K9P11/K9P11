CSS:
/* ==========================================================================
   CABECERA Y NAVEGACIÓN (COMPORTAMIENTO BASE / DESKTOP)
   ========================================================================== */

#main-header {
    position: fixed;
    top: 0;
    width: 100%;
    height: 60px; /* Altura estricta para garantizar centrado vertical */
    z-index: 1000;
    padding: 0; /* Padding vertical en 0, el centrado lo hace Flexbox */
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: all 0.4s ease;
    display: flex;
    align-items: center; /* Centrado vertical absoluto */
    max-width: 100vw;
}

#main-header.header-scrolled {
    background: var(--glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--border);
}

.nav-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center; /* Asegura que el contenido interno se centre a lo alto */
    width: 100%;
    height: 100%; /* Toma los 60px del header */
    padding: 0 2rem;
    gap: 2rem;
}

/* 1. Lado Izquierdo (Logo) */
.brand-logo-container {
    display: inline-flex;
    align-items: center;
    height: 100%;
}

.ap-logo {
    width: clamp(32px, 4vw, 36px);
    height: auto;
    color: var(--text-main);
    transition: transform 0.4s ease;
}

.brand-logo-container:hover .ap-logo {
    transform: translateY(-2px) scale(1.03);
}

/* 2. Menú (Botón Volver) */
.nav-links.case-study-nav {
    display: flex;
    gap: 2rem;
    align-items: center;
    list-style: none;
    flex: 1;
    justify-content: flex-end;
    margin: 0;
    padding: 0;
    height: 100%;
}

.back-to-home {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.3s ease;
}

.back-to-home svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.back-to-home:hover {
    color: var(--accent);
}

.back-to-home:hover svg {
    transform: translateX(-5px);
}

/* 3. Lado Derecho (Switches) */
.nav-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
}

.nav-settings {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--border);
}

.btn-text-toggle, .btn-icon-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-main);
    display: flex;
    align-items: center;
}

.lang-label { opacity: 0.5; transition: 0.3s ease; }
.lang-label.current { opacity: 1; color: var(--accent); font-weight: bold; }
.sun-icon, .moon-icon { width: 20px; height: 20px; }
[data-theme="light"] .sun-icon, [data-theme="dark"] .moon-icon { display: none; }

/* Ocultar hamburguesa por defecto */
.mobile-menu-btn { display: none; }


/* ==========================================================================
   Menú RESPONSIVE (SOLO MÓVIL: <= 768px)
   ========================================================================== */

@media (max-width: 768px) {
    /* Ocultamos botón hamburguesa definitivamente en este caso de estudio */
    .mobile-menu-btn {
        display: none !important;
    }

    /* Lado Izquierdo: LOGO */
    .brand-logo-container {
        flex: 1 1 0; 
        order: 1; /* Forzamos primera posición */
        justify-content: flex-start;
    }

    /* Lado Central: SWITCHES */
    .nav-actions {
        flex: 1 1 0;
        order: 2; /* Forzamos segunda posición (centro) */
        justify-content: center;
    }
    .nav-settings {
        border-left: none; /* Quitamos borde de división */
        padding-left: 0;
        gap: 0.8rem;
    }

    /* Lado Derecho: BOTÓN VOLVER */
    .nav-links.case-study-nav {
        flex: 1 1 0;
        order: 3; /* Forzamos tercera posición (derecha) */
        justify-content: flex-end;
        position: static; /* Rompemos herencia de menú móvil antiguo */
        width: auto;
        height: auto;
        background: none;
        backdrop-filter: none;
        transform: none;
        flex-direction: row;
        padding: 0; 
        margin: 0;
    }
    .nav-links{
        border-left:none;

    }
    .nav-links li {
        opacity: 1;
        transform: none;
    }
    .nav-links a {
        align-items: center;
        justify-content: flex-end;
        padding: 10px;
    }
    .nav-links a::before {
        display: none !important; /* Evita que aparezca el "01" */
    }

    /* Asegurar que el botón se pegue al borde y no se rompa */
    .back-to-home {
        padding: 0; /* Sin padding interno que desplace el texto */
        margin: 0;
        gap: 5px;
        white-space: nowrap; /* CRÍTICO: Fuerza al texto y al ícono a no separarse en 2 líneas */
    }
    
    .back-to-home span {
        display: inline-block !important; /* Mantiene el texto siempre visible */
        font-size: 0.9rem;
    }
    .back-to-home svg {
        width: 18px;
        height: 18px;
    }    
}










/* ==========================================================================
   SECCIÓN HERO
   ========================================================================== */
.hero-tuali {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    min-height: 100vh;
    max-height: 100vh;
    align-items: center;
