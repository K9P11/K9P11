}
.progress-bar-accent-3 {
    height: 100%;
    width: 70%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
}


/* ==============================   DERECHA   ============================== */
.product-canvas-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    perspective: 1200px;
}

/* El Case y su Levitación */
.canvas-hardware-frame {
    display: inline-flex; 
    background: var(--bg-secondary);
    border-radius: 16px;
    padding: 10px;
    border: 1px solid var(--border);
    
    /* Estado base 3D */
    transform: rotateY(-15deg) rotateX(5deg);
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    transform-style: preserve-3d;
    
    /* Movimiento oscilatorio */
    animation: levitate 6s ease-in-out infinite;
    will-change: transform, translate, box-shadow;
}

@keyframes levitate {
    0%, 100% { translate: 0px 0px; box-shadow: 0 40px 80px rgba(0,0,0,0.2); }
    50% { translate: 0px -15px; box-shadow: 0 60px 110px rgba(0,0,0,0.4); }
}

/* Vista Frontal al interactuar */
.canvas-hardware-frame:hover {
    transform: rotateY(0deg) rotateX(0deg);
}

/* Contenedor de la pantalla */
.hardware-inner {
    position: relative;
    background: #000;
    border-radius: 8px;
    height: 65vh; 
    max-height: 812px;
    aspect-ratio: 375 / 812;
    width: auto;
}

/* La Imagen */
.product-shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.image-rounded {
    border-radius: 8px; 
}

/* --------------------------------------------------------
   TABLETS Y PANTALLAS MEDIANAS (Hasta 992px)
   -------------------------------------------------------- */
@media screen and (max-width: 992px) {
    .hero-tuali {
        /* Pasamos de Grid a Flex para tener mejor control vertical */
        display: flex;
        flex-direction: column;
        min-height: auto;
        max-height: none; /* Quitamos el bloqueo de pantalla completa */
        padding-top: 120px; /* Espacio extra superior para evitar choque con navbar */
        padding-bottom: 0px;
        gap: 4rem; /* Separación clara entre el texto y el teléfono */
    }

    .hero-tuali-content {
        order: 1; /* Forzamos que el texto vaya primero */
        width: 100%;
    }

    .product-canvas-container {
        order: 2; /* Forzamos que el teléfono vaya abajo */
        width: 100%;
        perspective: 900px; /* Suavizamos un poco la perspectiva */
        display: none;
    }

    /* Suavizamos la rotación 3D para evitar desbordes en pantallas más angostas */
    .canvas-hardware-frame {
        transform: rotateY(-5deg) rotateX(2deg);
    }

    /* El teléfono ahora depende del ancho, no del alto de la pantalla */
    .hardware-inner {
        height: auto;
        width: 60%; /* Ocupa el 60% del contenedor en tablet */
        max-width: 340px;
        aspect-ratio: 375 / 812; /* Mantiene la proporción de iPhone nativa */
    }
}

/* --------------------------------------------------------
   MÓVILES (Hasta 768px)
   -------------------------------------------------------- */
@media screen and (max-width: 768px) {
    .hero-tuali {
        padding-top: 100px;
        gap: 3rem;
    }

    /* Ajuste fino de tipografía para evitar que choque en bordes */
    .project-title-xl {
        font-size: clamp(2.5rem, 10vw, 3.5rem); 
    }

    .project-summary-inter, .ltv-acronym {
        font-size: 1.05rem; /* Letra un poco más digerible en móvil */
    }

    /* Ocultamos la explicación del acrónimo para limpiar la lectura */
    .ltv-full-text {
        display: none;
    }

    /* Los KPIs bajan a formato lista (1 sola columna) */
    .kpi-instrument-panel {
        flex-direction: column;
        gap: 2rem;
        width: 100%;
    }

    .kpi-instrument {
        width: 100%;
        gap: 8px;
    }

    /* Hacemos que las barras visuales aprovechen el ancho en móvil */
    .barpro {
        width: 100%;
    }

    /* Eliminamos completamente el ángulo 3D en móvil, dejamos solo la levitación */
    .canvas-hardware-frame {
        transform: rotateY(0deg) rotateX(0deg);
    }
    
    /* Prevenir que el efecto hover en móviles trabe el estado de rotación */
    .canvas-hardware-frame:hover {
        transform: rotateY(0deg) rotateX(0deg);
    }

    /* Ajuste final del tamaño del dispositivo para celulares */
    .hardware-inner {
        width: 100%; /* Se hace más ancho relativo a la pantalla del celular */
        max-width: 240px;
    }
}










