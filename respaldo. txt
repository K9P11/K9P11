/* ---------------------------------------------------
   SECCIÓN 03: MÓDULOS (Tabs Híbridos / Acordeón)
--------------------------------------------------- */
.interactive-tabs-layout {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
}

/* =========================================
   ESTILOS DE TABS (DESKTOP)
========================================= */
.tabs-header-container {
    display: flex;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 0.5rem;
    gap: 0.5rem;
}

.tab-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.25rem 1rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
    color: var(--text-main);
    font-size: 1.1rem;
    font-weight: 600;
    opacity: 0.5; /* Inactive State */
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}


/* Hover State */
.tab-btn:hover {
    opacity: 0.2;
    background: rgba(255, 255, 255, 0.03);
}

/* Pressed State */
.tab-btn:active {
    transform: scale(0.98);
}

/* Active State */
.tab-btn.active {
    opacity: 1;
    background: var(--bg-secondary);
    border-color: var(--border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

/* =========================================
   ESTILOS DE CONTENEDORES Y ACORDEÓN
========================================= */
.tabs-content-container {
    width: 100%;
}

.accordion-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.accordion-item.active {
    background: var(--bg-secondary);
    border-color: var(--border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

/* MOBILE: Comportamiento nativo de acordeón */
.accordion-header {
    width: 100%;
    display: flex;
    align-items: center;
    /*justify-content: space-between;*/
    padding: 1.75rem 2.5rem;
    background: transparent;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    transition: border-color 0.3s ease;
    user-select: none;
    gap: 2rem;
}

.accordion-item:hover .accordion-cta-btn {
    color: var(--accent);
}

.header-left {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    width: 100%;
}

.cell-headline { margin: 0; }

.accordion-cta-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: none;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    pointer-events: none;
    min-width: fit-content;
}

.cta-chevron { transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1); }
.accordion-item.active .cta-chevron { transform: rotate(-180deg); }

.accordion-content {
    display: none;
    opacity: 0;
}

/* =========================================
   LAYOUT INTERNO (Textos 1.5fr / Mockup 0.5fr)
========================================= */
.accordion-item.active .accordion-content {
    display: block;
    animation: fadeInAccordion 0.4s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

@keyframes fadeInAccordion {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}

.content-inner.layout-split {
    display: grid;
    /* Ajuste exacto solicitado: Texto a la izquierda (1.5fr) y Mockup a la derecha (0.5fr) */
    grid-template-columns: 1.5fr 0.5fr; 
    gap: 4rem;
    padding: 2.5rem 3rem;
    align-items: center;
}

.text-side { display: flex; flex-direction: column; gap: 1.5rem; }
.problem-text { font-size: 1.05rem; line-height: 1.6; opacity: 0.85; margin: 0; }
.mockup-explanation-block { border-left: 2px solid var(--border); padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem;}
.mockup-caption { font-size: 0.85rem; opacity: 0.65; font-style: italic; margin: 0; white-space: pre-line; line-height: 1.8; }
.scroll-hint { font-size: 0.8rem; color: var(--accent); font-weight: 600; }

.visual-side { display: flex; justify-content: center; align-items: center; width: 100%; }
.device-container { position: relative; width: 100%; max-width: 210px; margin: 0 auto; cursor: pointer; }
.device-frame { width: 100%; position: relative; z-index: 2; pointer-events: none; }
.device-screen-scroll {
    position: absolute;
    top: 1px;
    left: 1px;
    width: calc(100% - 2px);
    height: calc(100% - 6px);
    border-radius: 28px;
    overflow-x: hidden;
    overflow-y: scroll;
    z-index: 1;
    background: #090d16;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
}
.device-screen-scroll::-webkit-scrollbar { width: 0px; background: transparent; }
.scrollable-content { width: 100%; display: block; }


/* =========================================
   MODAL FULLSCREEN (MOCKUP OVERLAY)
========================================= */
/* Contenedor principal del modal */
.mockup-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(15,23,42,.9); 
    backdrop-filter: blur(12px); 
    -webkit-backdrop-filter: blur(12px);
    z-index: 9999; /* Por encima de toda la página */
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
}

/* Estado activo cuando se hace clic */
.mockup-modal-overlay.is-active {
    opacity: 1;
    pointer-events: auto;
}

/* Contenedor del teléfono inyectado */
.modal-body {
    transform: scale(0.8);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    max-height: 85vh;
}

/* Escala del teléfono al abrirse en Desktop */
.mockup-modal-overlay.is-active .modal-body {
    transform: scale(1.3); 
}

/* Escala ajustada para Móviles (para que no se salga de la pantalla) */
@media (max-width: 768px) {
    .mockup-modal-overlay.is-active .modal-body {
        transform: scale(1.15); 
    }
}

/* Botón flotante de cerrar */
.modal-close-btn {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 0.6rem 1.2rem;
    border-radius: 50px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s ease, transform 0.2s ease;
    z-index: 10000;
}

.modal-close-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
}

/* Bloqueo del scroll en la página de fondo */
body.modal-open {
    overflow: hidden;
}

/* =========================================
   MEDIA QUERIES (TRANSICIÓN A ACORDEÓN)
========================================= */
@media (min-width: 993px) {
    .accordion-header { display: none; }
    .accordion-item { display: none; }
    .accordion-item.active { display: block; border-color: transparent; }
}

@media (max-width: 992px) {
    /* Ocultamos los Tabs de Desktop */
    .tabs-header-container { display: none; }
    
    /* Contenedor global: le damos espacio entre tarjetas */
    .tabs-content-container {
        display: flex;
        flex-direction: column;
        gap: 1.25rem; 
    }

    .accordion-item { display: block; } 
    
    /* Optimizamos los tamaños de las fuentes en móvil */
    .accordion-header {
        padding: 1.5rem;
    }
    
    .cell-headline {
        font-size: 1.1rem;
        width: 100%;
    }

    /* Ajuste perfecto del espaciado interno */
    .content-inner.layout-split {
        grid-template-columns: 1fr;
        gap: 2.5rem;
        padding: 0 1.5rem 2rem 1.5rem; /* Margen superior 0 para conectar suave con el header */
    }
    
    /* Invertimos el orden: Mockup arriba, Texto abajo */
    .visual-side { 
        order: 1; 
        margin-top: 0.5rem;
    }
    .text-side { 
        order: 1; 
    }
    
    /* Crecemos un poco el dispositivo para mejorar la legibilidad en pantallas pequeñas */
    .device-container { 
        max-width: 230px; 
    }

    /* Reducimos el tamaño de la fuente para evitar textos enormes en móvil */
    .problem-text {
        font-size: 0.95rem;
    }
}
























/* ---------------------------------------------------
   SECCIÓN PROCESOS: TIMELINE Y VISOR DOCUMENTO (FAKE PDF)
--------------------------------------------------- */
.process-timeline-wrapper {
    display: flex;
    flex-direction: column;
    margin-top: 4rem;
}

.timeline-step { display: flex; gap: 2rem; position: relative; }
.timeline-marker { display: flex; flex-direction: column; align-items: center; width: 40px; flex-shrink: 0; }
.step-number { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: var(--bg-secondary, #f4f4f5); color: var(--text-main, #111); font-size: 0.875rem; font-weight: 700; z-index: 2; }
.step-line { width: 2px; flex-grow: 1; background: var(--border, #e4e4e7); margin-top: 1rem; margin-bottom: 1rem; }
.step-line.is-last { display: none; }

.step-content {
