                                    <div class="device-container">
                                        <img src="/proyectos/Tuali/assets/section_03/frame-core.png" class="device-frame" alt="Phone Frame Overlay">
                                        <div class="device-screen-scroll">
                                            <img src="/proyectos/Tuali/assets/section_03/layout-core.png" class="scrollable-content" alt="Rewards UI">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Módulo 02 -->
                    <div class="accordion-item" id="module-02" role="tabpanel">
                        <div class="accordion-header">
                            <div class="header-left">
                                <h5 class="cell-headline" data-key="insights_card_2_title">Loyalty Program</h5>
                            </div>
                            <button class="accordion-cta-btn" tabindex="-1">
                                <span class="cta-text" data-key="cta_see_more">Ver más</span>
                                <svg class="cta-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </button>
                        </div>
                        <div class="accordion-content">
                            <div class="content-inner layout-split">
                                <!-- LADO IZQUIERDO: Textos -->
                                <div class="text-side">
                                    <p class="problem-text" data-key="insights_user_2">
                                        Conceptualization and interaction design for the rewards section, built to drive merchant retention and increase Lifetime Value (LTV).
                                    </p>
                                    <div class="mockup-explanation-block">
                                        <p class="mockup-caption" data-key="insights_detail_2">➔ Showing: Rewards tier dashboard and points conversion workflow.</p>
                                        <span class="scroll-hint" data-key="scroll_hint">🖱️ Scroll inside the device to explore the full layout</span>
                                    </div>
                                </div>
                                <!-- LADO DERECHO: Mockup -->
                                <div class="visual-side">
                                    <div class="device-container">
                                        <img src="/proyectos/Tuali/assets/section_03/frame-gana.png" class="device-frame" alt="Phone Frame Overlay">
                                        <div class="device-screen-scroll">
                                            <img src="/proyectos/Tuali/assets/section_03/layout-gana.png" class="scrollable-content" alt="Rewards UI">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Módulo 03 -->
                    <div class="accordion-item" id="module-03" role="tabpanel">
                        <div class="accordion-header">
                            <div class="header-left">
                                <h5 class="cell-headline" data-key="insights_card_3_title">Credit Management</h5>
                            </div>
                            <button class="accordion-cta-btn" tabindex="-1">
                                <span class="cta-text" data-key="cta_see_more">Ver más</span>
                                <svg class="cta-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </button>
                        </div>
                        <div class="accordion-content">
                            <div class="content-inner layout-split">
                                <!-- LADO IZQUIERDO: Textos -->
                                <div class="text-side">
                                    <p class="problem-text" data-key="insights_user_3">
                                        UI design for financing control and visualization. Provides a transparent and secure experience for applying credit lines, eliminating financial friction.
                                    </p>
                                    <div class="mockup-explanation-block">
                                        <p class="mockup-caption" data-key="insights_detail_3">➔ Showing: Statement view, credit token allocation, and payment history.</p>
                                        <span class="scroll-hint" data-key="scroll_hint">🖱️ Scroll inside the device to explore the full layout</span>
                                    </div>
                                </div>
                                <!-- LADO DERECHO: Mockup -->
                                <div class="visual-side">
                                    <div class="device-container">
                                        <img src="/proyectos/Tuali/assets/section_03/frame-creditos.png" class="device-frame" alt="Phone Frame Overlay">
