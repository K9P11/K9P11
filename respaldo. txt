}

.flow-content strong {
    color: #ffffff;
    font-weight: 600;
    margin-right: 4px;
}

/* Icono de la flecha (Limpio, sin fondo ni contenedor rígido) */
.flow-arrow-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff; /* Flecha blanca por defecto */
    flex-shrink: 0;
    margin-left: 12px;
    /* Animación solicitada aplicada directamente al elemento de la flecha */
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.3s ease;
}

.flow-arrow-icon svg {
    width: 18px;
    height: 18px;
}

/* Comportamiento de la flecha al hacer hover en la ficha (.flow-card-link) */
.flow-card-link:hover .flow-arrow-icon {
    color: var(--accent); /* Cambia al color acento de tu sitio */
    transform: scale(1.2) translateX(4px); /* Animación elástica + sutil empuje hacia la derecha */
}



















/* ---------------------------------------------------
   SECCIÓN 02: MISIÓN (Híbrido)
--------------------------------------------------- */
